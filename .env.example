# QueueSense Monorepo Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit real secrets to source control.

# Database (Supabase PostgreSQL pooler & direct URLs)
DATABASE_URL=postgresql://postgres.rtpylojjkwhxnybftizc:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.rtpylojjkwhxnybftizc:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Server & Runtime
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Allowed Frontend Origins (Render API CORS configuration)
CORS_ORIGIN=http://localhost:5173,https://queuesense.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://queuesense.vercel.app

# Frontend Backend Connection (Vercel Frontend environment variable)
VITE_API_URL=http://localhost:8000

# Supabase Auth Client Configuration
VITE_SUPABASE_URL=https://rtpylojjkwhxnybftizc.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_1WPkAfsJWrJFInlao_96Nw_wt5HOUy7
NEXT_PUBLIC_SUPABASE_URL=https://rtpylojjkwhxnybftizc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_1WPkAfsJWrJFInlao_96Nw_wt5HOUy7

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

# Domain Logic Configuration
NO_SHOW_GRACE_MINUTES=7
ETA_NOTIFICATION_THRESHOLD_MINUTES=5

# Workload Score Formula Weights (load_score = w1*count + w2*duration + w3*remaining + w4*priority)
WEIGHT_COUNT=1.0
WEIGHT_DURATION=1.0
WEIGHT_REMAINING=1.0
WEIGHT_PRIORITY=1.0
