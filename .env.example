# QueueSense Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to source control.

# Database
# For local development with PostgreSQL:
DATABASE_URL=postgresql://queuesense:queuesense@localhost:5432/queuesense
# For local development with SQLite (simpler, no PG install needed):
# DATABASE_URL=sqlite:///./queuesense.db

# Security
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Application
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# No-show grace period in minutes
NO_SHOW_GRACE_MINUTES=7

# ETA notification threshold in minutes (only notify if ETA changes by more than this)
ETA_NOTIFICATION_THRESHOLD_MINUTES=5

# Optional: External notification services (NOT required for core PS7)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SENDGRID_API_KEY=

# Optional: Gemini API (NOT required for core PS7 — only for optional admin summary feature)
# GEMINI_API_KEY=
