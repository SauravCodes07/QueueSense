{
  "name": "queuesense",
  "version": "1.0.0",
  "private": true,
  "description": "QueueSense — Outpatient Wait-Time & Dynamic Queue Velocity Tracker",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:api": "npm run dev --workspace=@queuesense/api",
    "dev:web": "npm run dev --workspace=@queuesense/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=@queuesense/api",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2"
  },
  "keywords": [
    "queuesense",
    "outpatient",
    "queue-management",
    "fastify",
    "react",
    "prisma"
  ],
  "author": "QueueSense Team",
  "license": "MIT"
}
