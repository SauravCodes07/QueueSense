# QueueSense Fastify API (Render Backend) Environment Configuration
# Set these in your Render Dashboard -> Environment Variables

# Database Connection (Supabase PostgreSQL pooler & direct URLs)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Server & Runtime
PORT=8000
HOST=0.0.0.0
NODE_ENV=production

# Allowed Frontend Origins (Vercel deployment domain and local development)
# You can use CORS_ORIGIN (single origin or wildcard) or CORS_ORIGINS (comma-separated)
CORS_ORIGIN=https://queuesense.vercel.app,http://localhost:5173
CORS_ORIGINS=https://queuesense.vercel.app,http://localhost:5173,http://localhost:3000

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

# Domain Logic Configuration
NO_SHOW_GRACE_MINUTES=7
ETA_NOTIFICATION_THRESHOLD_MINUTES=5

# Workload Score Formula Weights (load_score = w1*count + w2*duration + w3*remaining + w4*priority)
WEIGHT_COUNT=1.0
WEIGHT_DURATION=1.0
WEIGHT_REMAINING=1.0
WEIGHT_PRIORITY=1.0
