# QueueSense Environment Configuration
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres

PORT=8000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

NO_SHOW_GRACE_MINUTES=7
ETA_NOTIFICATION_THRESHOLD_MINUTES=5

WEIGHT_COUNT=1.0
WEIGHT_DURATION=1.0
WEIGHT_REMAINING=1.0
WEIGHT_PRIORITY=1.0
